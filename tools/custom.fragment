# --- VIRTUAL NETWORKS ---
#CONFIG_DUMMY=y

# --- NOMOUNT VFS ---
CONFIG_NOMOUNT=y

CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_CIFS_XATTR=y
